#!/usr/bin/env sh
# Pre-commit hook (PRD Ch3.16). Lints staged frontend files via lint-staged
# and staged backend Python files via ruff before allowing a commit.
set -e

if git diff --cached --name-only --diff-filter=ACM | grep -q '^frontend/'; then
  (cd frontend && pnpm exec lint-staged)
fi

PY_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '^backend/.*\.py$' || true)
if [ -n "$PY_FILES" ]; then
  (cd backend && .venv/Scripts/python -m ruff check $(echo "$PY_FILES" | sed 's#^backend/##'))
fi
