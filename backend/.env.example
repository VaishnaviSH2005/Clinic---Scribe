ENVIRONMENT=development
DEBUG=true

DATABASE_URL=postgresql+psycopg://cliniscribe:cliniscribe@localhost:5433/cliniscribe
REDIS_URL=redis://localhost:6379/0

# PRODUCTION REQUIRED: generate with `python -c "import secrets; print(secrets.token_hex(64))"`
# The app refuses to start in production if this value is the default or shorter than 32 characters.
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

CORS_ORIGINS=http://localhost:3000

STT_PROVIDER=faster_whisper
CLAUDE_API_KEY=
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=

FRONTEND_BASE_URL=http://localhost:3000
# Must match frontend/middleware.ts (the route guard looks for the access cookie by this name).
ACCESS_TOKEN_COOKIE_NAME=cliniscribe_access
REFRESH_TOKEN_COOKIE_NAME=cliniscribe_refresh
# PRODUCTION REQUIRED: must be true when serving over HTTPS.
# The app refuses to start with ENVIRONMENT=production and COOKIE_SECURE=false.
COOKIE_SECURE=false

# Dev-only seed account (migration 0004_seed_super_admin) — change immediately in production.
# Email: superadmin@cliniscribe.ai
# Password: ChangeMe123!

# Live captions during a consultation (PRD Ch9.6). The tiny model keeps captions ~4 s behind speech on a
# laptop CPU; the accurate transcript still uses WHISPER_MODEL_SIZE after the recording is stopped.
LIVE_WHISPER_MODEL_SIZE=tiny
LIVE_CHUNK_SECONDS=2.5
# Leave empty to auto-detect the language (same as the final transcript), or set e.g. en / hi.
LIVE_LANGUAGE=
